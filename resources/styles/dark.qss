* {
    color: #e7eaee;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 10.5pt;
}

QMainWindow,
QWidget#page {
    background: #101214;
}

QStatusBar {
    background: #14171a;
    color: #9aa4af;
    border-top: 1px solid #262c33;
}

QSplitter#mainSplitter::handle {
    background: #20272e;
    height: 6px;
}

QLabel#pageTitle {
    color: #ffffff;
    font-size: 20pt;
    font-weight: 700;
}

QLabel#sectionTitle {
    color: #9aa4af;
    font-size: 9.5pt;
    font-weight: 700;
}

QLabel#fieldLabel {
    color: #b7c0ca;
    font-size: 9.5pt;
    font-weight: 600;
}

QLabel#mutedText {
    color: #b7c0ca;
}

QWidget#panel,
QWidget#logPanel {
    background: #15191d;
    border: 1px solid #303842;
    border-radius: 8px;
}

QTableWidget#depotTable {
    background: #12161a;
    alternate-background-color: #151a1f;
    border: 1px solid #34404a;
    border-radius: 8px;
    color: #dce2e8;
    gridline-color: #34404a;
    outline: 0;
    selection-background-color: #263640;
}

QTableWidget#depotTable::item {
    padding: 4px 9px;
}

QTableWidget#depotTable QLineEdit {
    border-radius: 5px;
    min-height: 24px;
    padding: 4px 8px;
}

QHeaderView::section {
    background: #182027;
    border: 0;
    border-bottom: 1px solid #34404a;
    color: #b7c0ca;
    font-weight: 700;
    padding: 8px 10px;
}

QPlainTextEdit#logOutput,
QLineEdit,
QComboBox {
    background: #12161a;
    border: 1px solid #34404a;
    border-radius: 7px;
    color: #dce2e8;
    padding: 7px 10px;
    selection-background-color: #2d5f74;
}

QLineEdit,
QComboBox {
    min-height: 28px;
}

QPlainTextEdit#logOutput {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 9.5pt;
}

QProgressBar#steamProgressBar {
    background: #101316;
    border: 1px solid #2b323a;
    border-radius: 7px;
    color: #edf1f5;
    font-weight: 700;
    min-height: 28px;
    text-align: center;
}

QProgressBar#steamProgressBar::chunk {
    background: #26724f;
    border-radius: 6px;
}

QProgressBar#steamProgressBar[state="complete"]::chunk {
    background: #339464;
}

QProgressBar#steamProgressBar[state="error"]::chunk {
    background: #934141;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus {
    border-color: #487386;
}

QLineEdit::placeholder {
    color: #6f7a84;
}

QComboBox::drop-down {
    border: 0;
    width: 28px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #9aa4af;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background: #181c20;
    border: 1px solid #2b323a;
    color: #e7eaee;
    selection-background-color: #263640;
}

QPushButton {
    background: #22282f;
    border: 1px solid #343d47;
    border-radius: 7px;
    color: #edf1f5;
    font-weight: 600;
    min-height: 34px;
    padding: 7px 13px;
}

QPushButton:hover {
    background: #2a323b;
    border-color: #46515d;
}

QPushButton:pressed {
    background: #1d2329;
}

QPushButton#primaryButton {
    background: #26724f;
    border-color: #339464;
    color: #ffffff;
}

QPushButton#primaryButton:hover {
    background: #2c815a;
}

QPushButton#secondaryButton {
    min-width: 74px;
}

QPushButton#iconButton {
    background: #1d2329;
    border-color: #343d47;
    border-radius: 6px;
    font-size: 13pt;
    font-weight: 700;
    min-height: 28px;
    min-width: 32px;
    padding: 0;
}

QPushButton#iconButton:hover {
    background: #263039;
    border-color: #4b5865;
}

QPushButton:disabled,
QLineEdit:disabled,
QPlainTextEdit:disabled,
QComboBox:disabled,
QTableWidget:disabled,
QProgressBar:disabled,
QCheckBox:disabled {
    color: #68727c;
    background: #15191d;
    border-color: #252b32;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #46515d;
    background: #101316;
}

QCheckBox::indicator:checked {
    background: #26724f;
    border-color: #339464;
}
